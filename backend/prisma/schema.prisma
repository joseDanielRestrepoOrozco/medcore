// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  MEDICO
  ENFERMERA
  PACIENTE
  ADMINISTRADOR
}

model Users {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  email            String   @unique
  fullname         String
  current_password String
  status           String   @default("PENDING")
  phone            String? // Teléfono de contacto
  date_of_birth    DateTime
  gender           String?
  age              Int
  role             Role     @default(PACIENTE) // MEDICO, ENFERMERA, PACIENTE, ADMINISTRADOR
  // campos para doctores
  specialization   String? // Especialización médica (solo para médicos)
  department       String? // Departamento donde trabaja
  license_number   String? // Número de licencia médica

  // campos para verificación de email
  verificationCode        String?
  verificationCodeExpires DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}
