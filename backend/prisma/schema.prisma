// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Users {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  email                   String    @unique
  fullname                String
  currentPassword         String
  role                    String    @default("ADMINISTRADOR") // MEDICO, ENFERMERA, PACIENTE, ADMINISTRADOR
  status                  String    @default("PENDING")
  specialization          String? // Especialización médica (solo para médicos)
  department              String? // Departamento donde trabaja
  licenseNumber           String? // Número de licencia médica
  phone                   String? // Teléfono de contacto
  dateOfBirth             DateTime? // Fecha de nacimiento
  verificationCode        String?
  verificationCodeExpires DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}
